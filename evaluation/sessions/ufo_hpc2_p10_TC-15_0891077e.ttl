    gufo:inheresIn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/central> ;
    aii:constitutes <https://github.com/InformationServiceSystems/ai-intent/ontology#delegation/delegation%3Aanonymous-%3Ecentral> ;
    aii:content "Act only within the intent scope of mandate 'central' and never violate its boundary constraints" ;
