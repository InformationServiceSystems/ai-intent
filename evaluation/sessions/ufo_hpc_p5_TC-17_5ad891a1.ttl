<https://github.com/InformationServiceSystems/ai-intent/ontology#breach/bonds%2Fe5b27034-1793-4a53-882b-a06ad9809294> a gufo:Situation,
        aii:CommitmentBreach ;
    aii:answerableTo <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/anonymous>,
        <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/central> ;
