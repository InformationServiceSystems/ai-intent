<https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_BONDS_LADDER> a aii:RegulatoryRule ;
    rdfs:label "Laddered maturity structure required: no more than 30% maturing in any single year." .

<https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_STOCKS_ESG> a aii:RegulatoryRule ;
    rdfs:label "ESG screening required: must flag ESG concerns for any new position." .

