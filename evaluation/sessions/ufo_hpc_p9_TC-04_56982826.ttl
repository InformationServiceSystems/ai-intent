<https://github.com/InformationServiceSystems/ai-intent/ontology#commitment/commitment%3Abonds-%3Ecentral> a gufo:ExtrinsicMode,
        aii:Commitment ;
    gufo:externallyDependsOn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/central> ;
    gufo:inheresIn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/bonds> ;
