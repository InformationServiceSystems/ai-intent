aii:AccountabilityTrace rdfs:subClassOf gufo:Situation .

aii:CommitmentBreach rdfs:subClassOf gufo:Situation .

aii:Principal rdfs:subClassOf gufo:FunctionalComplex .

aii:Session rdfs:subClassOf gufo:Event .

<https://github.com/InformationServiceSystems/ai-intent/ontology#breach/stocks%2F60ee1995-b4e9-4340-a2c6-e4ecb785f274> a gufo:Situation,
        aii:CommitmentBreach ;
