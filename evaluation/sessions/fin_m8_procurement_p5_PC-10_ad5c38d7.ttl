<https://github.com/InformationServiceSystems/ai-intent/ontology#commitment/commitment%3Acoordinator-%3Emunicipality> a gufo:ExtrinsicMode,
        aii:Commitment ;
    gufo:externallyDependsOn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/municipality> ;
