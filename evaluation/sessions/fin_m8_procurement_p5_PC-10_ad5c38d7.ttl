    aii:constitutes <https://github.com/InformationServiceSystems/ai-intent/ontology#delegation/delegation%3Amunicipality-%3Ecoordinator> ;
    aii:content "Act only within the intent scope of mandate 'coordinator' and never violate its boundary constraints" ;
    aii:coversRule <https://github.com/InformationServiceSystems/ai-intent/ontology#rule/DIR2014_24_ART18_PRINCIPLES>,
        <https://github.com/InformationServiceSystems/ai-intent/ontology#rule/DIR2014_24_ART67_AWARD_CRITERIA>,
