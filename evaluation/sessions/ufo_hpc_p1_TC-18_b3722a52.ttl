    rdfs:label "Portfolio duration must remain below 10 years." .

<https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_CENTRAL_ACTIONABLE_OUTPUT> a aii:RegulatoryRule ;
    rdfs:label "Final recommendation must contain at least one specific, quantified guidance (allocation percentage, duration, rating floor, or equivalent numeric parameter). Qualitative-only language ('limited allocation', 'balanced approach') is not sufficient." .

<https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_MATERIALS_MAX_ALLOC> a aii:RegulatoryRule ;
    rdfs:label "Maximum 15% of total portfolio in raw materials." .

