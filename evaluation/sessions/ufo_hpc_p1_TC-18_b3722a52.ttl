<https://github.com/InformationServiceSystems/ai-intent/ontology#commitment/commitment%3Acentral-%3Eanonymous> a gufo:ExtrinsicMode,
        aii:Commitment ;
    gufo:externallyDependsOn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/anonymous> ;
    gufo:inheresIn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/central> ;
    aii:constitutes <https://github.com/InformationServiceSystems/ai-intent/ontology#delegation/delegation%3Aanonymous-%3Ecentral> ;
    aii:content "Act only within the intent scope of mandate 'central' and never violate its boundary constraints" ;
    aii:coversRule <https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_CENTRAL_ACCOUNTABILITY>,
        <https://github.com/InformationServiceSystems/ai-intent/ontology#rule/MANIFEST_CENTRAL_ACTIONABLE_OUTPUT>,
