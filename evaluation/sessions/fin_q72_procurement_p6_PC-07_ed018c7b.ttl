aii:CommitmentBreach rdfs:subClassOf gufo:Situation .

aii:MandateAmendment rdfs:subClassOf gufo:Event .

aii:NormException rdfs:subClassOf gufo:Object .

<https://github.com/InformationServiceSystems/ai-intent/ontology#claim/claim%3Acoordinator-%3Eservices> a gufo:ExtrinsicMode,
        aii:Claim ;
    gufo:externallyDependsOn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/services> ;
    gufo:inheresIn <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/coordinator> ;
    aii:constitutes <https://github.com/InformationServiceSystems/ai-intent/ontology#delegation/delegation%3Acoordinator-%3Eservices> ;
