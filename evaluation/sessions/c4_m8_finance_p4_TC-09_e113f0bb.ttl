aii:AccountabilityTrace rdfs:subClassOf gufo:Situation .

aii:CommitmentBreach rdfs:subClassOf gufo:Situation .

aii:Principal rdfs:subClassOf gufo:FunctionalComplex .

aii:Session rdfs:subClassOf gufo:Event .

<https://github.com/InformationServiceSystems/ai-intent/ontology#breach/bonds%2Fb30f1459-6316-4c95-8f8b-3c5327c449c4> a gufo:Situation,
        aii:CommitmentBreach ;
    aii:answerableTo <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/anonymous>,
        <https://github.com/InformationServiceSystems/ai-intent/ontology#agent/central> ;
    aii:breachedCommitment <https://github.com/InformationServiceSystems/ai-intent/ontology#commitment/commitment%3Abonds-%3Ecentral> ;
