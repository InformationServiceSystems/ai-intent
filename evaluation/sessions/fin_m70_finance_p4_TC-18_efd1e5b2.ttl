    aii:constitutes <https://github.com/InformationServiceSystems/ai-intent/ontology#delegation/delegation%3Acentral-%3Ebonds> ;
    aii:content "Act only within the intent scope of mandate 'bonds' and never violate its boundary constraints" ;
    aii:coversRule <https://github.com/InformationServiceSystems/ai-intent/ontology#rule/DISPOSITION_ANTI_CUSTOMER_COMPLEXITY>,
